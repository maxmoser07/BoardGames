# Wird von docker compose automatisch gelesen. Kopieren:
#
#   cp .env.example .env
#
# Alles optional - ohne .file gelten die Defaults aus docker-compose.yml.
# Diese Datei wird eingecheckt, .env nicht (siehe .gitignore).

# Datenbank-Zugangsdaten. Das mysql-Image legt Datenbank und Benutzer damit an.
MYSQL_DATABASE=boardgames
MYSQL_USER=boardgames
MYSQL_PASSWORD=boardgames
MYSQL_ROOT_PASSWORD=boardgames-root

# Veröffentlichte Ports auf dem Host. 5173 kollidiert mit einem laufenden
# `npm run dev` auf dem Host - dann hier z. B. 5180 eintragen.
FRONTEND_PORT=5173
BACKEND_PORT=3000
MYSQL_PORT=3306
