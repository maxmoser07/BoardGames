# Von cargo-dotenv zur Laufzeit gelesen. Nicht einchecken - .env ist in .gitignore.
DATABASE_URL=mysql://boardgames:boardgames@127.0.0.1:3306/boardgames
BIND_ADDR=127.0.0.1:3000

# Google- und GitHub-Anmeldung (OAuth 2.0, Authorization Code Flow).
# Ohne Werte bleiben die beiden Buttons im Login deaktiviert; Passwort und
# Registrierung laufen weiter.
#
# Google (Cloud Console → OAuth-Client, Web Application):
#   Redirect-URI eintragen: <OAUTH_REDIRECT_BASE>/api/auth/oauth/google/callback
# GitHub (github.com → Settings → Developer settings → OAuth Apps):
#   Callback-URL eintragen:  <OAUTH_REDIRECT_BASE>/api/auth/oauth/github/callback
#
# OAUTH_REDIRECT_BASE ist die Adresse, unter der die Callback-Routen erreichbar
# sind. Lokal: http://localhost:3000 (Vite leitet /api an das Backend weiter).
# In Produktion muss diese Adresse öffentlich und exakt so beim Anbieter
# hinterlegt sein.
OAUTH_REDIRECT_BASE=http://localhost:3000
# Ziel nach dem Login – die App-Oberfläche (Vite-Port).
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
